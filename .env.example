# ---------------------------------------------------------------------------
# Backend selection. Valid: groq | cerebras | gemini | ollama | mock
# `mock` is deterministic and needs no network -- evals and tests default to it,
# so a clean clone passes with zero keys.
# ---------------------------------------------------------------------------
CALORAI_TEXT_BACKEND=groq
CALORAI_VISION_BACKEND=gemini
CALORAI_TEXT_FALLBACK=cerebras

# ---------------------------------------------------------------------------
# Keys. All three are free, no credit card.
#   Groq     -> https://console.groq.com/keys
#   Gemini   -> https://aistudio.google.com/apikey
#   Cerebras -> https://cloud.cerebras.ai
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=

# Model ids (override if a provider retires one)
GROQ_TEXT_MODEL=openai/gpt-oss-20b
CEREBRAS_TEXT_MODEL=llama-3.3-70b
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# ---------------------------------------------------------------------------
# Behaviour flags
# ---------------------------------------------------------------------------
# Deterministic short-circuit for read-only intents. Set 0 to force every turn
# through the full agent loop (the eval suite does exactly this).
CALORAI_FAST_PATH=1
CALORAI_DB_PATH=calorai.db

# Optional tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=calorai-agent
