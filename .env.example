# ---------------------------------------------------------------------------
# Backend selection. Valid: groq | cerebras | gemini | ollama | mock
# `mock` is deterministic and needs no network -- evals and tests default to it,
# so a clean clone passes with zero keys.
# ---------------------------------------------------------------------------
CALORAI_TEXT_BACKEND=groq
CALORAI_VISION_BACKEND=mistral-vision
CALORAI_VISION_FALLBACK=gemini
CALORAI_TEXT_FALLBACK=mistral

# ---------------------------------------------------------------------------
# Keys. All three are free, no credit card.
#   Groq     -> https://console.groq.com/keys
#   Gemini   -> https://aistudio.google.com/apikey
#   Cerebras -> https://cloud.cerebras.ai
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=

# Mistral -> https://console.mistral.ai   (free Experiment tier; note it
# requires opting into training on your inputs -- fine for a demo, not for
# real user data). Gives Pixtral, a second vision model.
MISTRAL_API_KEY=
MISTRAL_TEXT_MODEL=ministral-8b-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409

# OpenRouter -> https://openrouter.ai/keys  (one key, many free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

# Model ids (override if a provider retires one)
GROQ_TEXT_MODEL=openai/gpt-oss-20b
CEREBRAS_TEXT_MODEL=gpt-oss-120b
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# ---------------------------------------------------------------------------
# Behaviour flags
# ---------------------------------------------------------------------------
# Deterministic short-circuit for read-only intents. Set 0 to force every turn
# through the full agent loop (the eval suite does exactly this).
CALORAI_FAST_PATH=1
CALORAI_DB_PATH=calorai.db

# ---------------------------------------------------------------------------
# LangSmith tracing (optional). Free Developer tier: 5,000 traces/month, one
# seat, no credit card -- https://smith.langchain.com
#
# Set LANGSMITH_TRACING=true and paste a key, then run any turn and the trace
# appears in the project below. The CLI banner and the Streamlit sidebar both
# report whether tracing is actually on, because the failure mode here is
# silence: a wrong env var name means no traces and no error.
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=calorai-agent
